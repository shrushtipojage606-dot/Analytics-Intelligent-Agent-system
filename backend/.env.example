# --- Server ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# SQLite is used by default; point SQLITE_PATH elsewhere or swap utils/db.py
# for a Postgres driver (e.g. psycopg2) in production.
SQLITE_PATH=./analytics.db

# --- AI (optional) ---
# If set, the Business Intelligence Agent asks Claude to phrase pre-computed
# statistics as fluent narrative text. Numbers are ALWAYS computed in Python;
# the LLM never invents or recalculates them. Leave blank to use the
# deterministic template fallback (the app works fully without this key).
ANTHROPIC_API_KEY=

# --- Email alerts (SMTP) ---
# Leave blank to run the Alert Agent in dry-run mode (alerts are logged, not sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@yourcompany.com
DASHBOARD_URL=http://localhost:5173
